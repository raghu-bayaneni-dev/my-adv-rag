# ==============================================================================
# Enterprise Guardrailed RAG Configuration Template
# ==============================================================================

# Default Generator & Guardrail Models (Ultra-fast LPU inference on Groq)
DEFAULT_LLM_MODEL=groq/llama-3.3-70b-versatile
GUARDRAIL_LLM_MODEL=groq/llama-3.1-8b-instant

# Embedding Configuration
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage & Ingestion Paths
DATA_DIR=data
CHROMA_PERSIST_DIR=data/chroma_db
CHUNK_SIZE=600
CHUNK_OVERLAP=120

# Guardrail & Security
ENABLE_PII_REDACTION=true
ENABLE_PROMPT_INJECTION_DEFENSE=true
GUARDRAIL_TEMPERATURE=0.0

# Server / App Settings
APP_TITLE=Enterprise Guardrailed RAG
ENVIRONMENT=development
LOG_LEVEL=INFO
