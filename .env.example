# ==============================================================================
# Enterprise Guardrailed RAG Configuration
# ==============================================================================

# LLM Provider API Keys (Leave blank if using local mock or providing via UI sidebar)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Default Generator & Guardrail Models
DEFAULT_LLM_MODEL=gemini/gemini-2.0-flash
GUARDRAIL_LLM_MODEL=gemini/gemini-2.0-flash

# Embedding Configuration
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage & Ingestion Paths
DATA_DIR=data
CHROMA_PERSIST_DIR=data/chroma_db
CHUNK_SIZE=600
CHUNK_OVERLAP=120

# Guardrail & Security
ENABLE_PII_REDACTION=true
ENABLE_PROMPT_INJECTION_DEFENSE=true
GUARDRAIL_TEMPERATURE=0.0

# Server / App Settings
APP_TITLE=Enterprise Guardrailed RAG
ENVIRONMENT=development
LOG_LEVEL=INFO
